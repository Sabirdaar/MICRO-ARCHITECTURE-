FROM node:22-alpine

WORKDIR /app

# Copy package files first for better layer caching
COPY package*.json ./

# Use npm ci for reproducible builds
RUN npm ci

# Copy source code
COPY . .

EXPOSE 5173

# Use start script which already includes --host flag
CMD ["sh", "-c", "echo 'Starting frontend...' && npm run dev -- --host 0.0.0.0"]
